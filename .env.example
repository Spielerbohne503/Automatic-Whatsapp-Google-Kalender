# ─── WhatsApp / CallMeBot ───────────────────────────────────────────────────
# Deine Handynummer im internationalen Format (mit + und Ländervorwahl)
WHATSAPP_PHONE=+491701234567
# API-Key von https://www.callmebot.com/blog/free-api-whatsapp-messages/
CALLMEBOT_API_KEY=dein_api_key_hier

# ─── Google Kalender ────────────────────────────────────────────────────────
# "primary" für den Hauptkalender oder die Kalender-ID aus Google Kalender
GOOGLE_CALENDAR_ID=primary

# ─── Verhalten ──────────────────────────────────────────────────────────────
# Wie oft der Kalender abgefragt wird (in Minuten)
POLL_INTERVAL_MINUTES=5
# Wie weit in die Zukunft nach Terminen gesucht wird (in Stunden)
LOOKAHEAD_HOURS=24
# Deine Zeitzone (z.B. Europe/Berlin, Europe/Vienna, Europe/Zurich)
TIMEZONE=Europe/Berlin
# Uhrzeit für ganztägige Termine: Wann soll die Erinnerung erscheinen? (Stunde, 0-23)
ALL_DAY_REMINDER_HOUR=8

# ─── Dateipfade (Standard-Werte, normalerweise nicht ändern) ─────────────────
TOKEN_FILE=token.json
CREDENTIALS_FILE=credentials.json
STATE_FILE=sent_notifications.json
